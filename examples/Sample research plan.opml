<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0" xmlns:ol="urn:outline-app:opml:1">
  <head>
    <title>Sample research plan</title>
    <ol:column id="topic" name="Topic"/>
    <ol:column id="c2" name="Source" width="180"/>
    <ol:column id="c3" name="Status" width="120"/>
  </head>
  <body>
    <outline text="&lt;strong&gt;1. Introduction&lt;/strong&gt;" ol:col-c3="Drafting">
      <outline text="Research question" _note="&lt;p&gt;How does &lt;em&gt;X&lt;/em&gt; affect &lt;em&gt;Y&lt;/em&gt; in small communities?&lt;/p&gt;"/>
      <outline text="Why it matters" ol:col-c2="Smith 2021, p. 12"/>
    </outline>
    <outline text="&lt;strong&gt;2. Literature review&lt;/strong&gt;" ol:col-c3="Reading">
      <outline text="Early studies" ol:col-c2="Jones 1998">
        <outline text="Key finding: &lt;u&gt;sample sizes were small&lt;/u&gt;"/>
        <outline text="Critique by &lt;a href=&quot;https://example.com&quot;&gt;Lee&lt;/a&gt;" ol:col-c2="Lee 2004"/>
      </outline>
      <outline text="Recent work" ol:collapsed="true">
        <outline text="Meta-analysis" ol:col-c2="Patel 2023"/>
        <outline text="&lt;s&gt;Survey of practitioners&lt;/s&gt; (out of scope)"/>
      </outline>
    </outline>
    <outline text="&lt;strong&gt;3. Method&lt;/strong&gt;" ol:col-c3="Not started"/>
  </body>
</opml>
